# Admin portal on mock data (`npm run dev:admin:mock`), no backend needed.
# `--mode admin.mock` loads .env, then this file (not .env.admin), so it sets the admin target itself.
VITE_APP_TARGET=admin
VITE_USE_MOCK=true

# Unused while mocked: every request is answered by src/mock/index.js
VITE_API_URL=http://localhost:5001/api/v1/admin
